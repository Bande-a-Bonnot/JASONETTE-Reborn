{
  "name": "@jasonette/web",
  "version": "0.1.0",
  "description": "Web renderer for the $jason protocol — renders JSON markup as interactive web pages",
  "type": "module",
  "main": "./dist/jasonette.cjs",
  "module": "./dist/jasonette.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/jasonette.js",
      "require": "./dist/jasonette.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "bin": {
    "jasonette": "./bin/cli.js"
  },
  "files": [
    "dist",
    "bin"
  ],
  "scripts": {
    "dev": "vite",
    "build": "vite build && tsc --emitDeclarationOnly && cp src/jasonette.css dist/jasonette.css && npm run build:cli",
    "build:cli": "esbuild src/cli.ts --bundle --platform=node --format=esm --outfile=bin/cli.js --packages=external",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@jasonette/template-engine": "0.1.0"
  },
  "devDependencies": {
    "@types/node": "^25.3.2",
    "jsdom": "^25.0.0",
    "tsx": "^4.22.3",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT"
}
