{
  "$jason": {
    "head": {
      "title": "$jason.body.background web container (agent)"
    },
    "body": {
      "header": {
        "title": "Web Container Agent"
      },
      "sections": [
        {
          "items": [
            {
              "type": "vertical",
              "components": [
                {
                  "type": "label",
                  "text": "Ignore All User Interaction",
                  "style": {
                    "font": "HelveticaNeue-Bold",
                    "size": "14"
                  }
                },
                {
                  "type": "label",
                  "text": "By default all web containers ignore user interaction such as touch or scroll",
                  "style": {
                    "font": "HelveticaNeue",
                    "size": "12"
                  }
                }
              ],
              "href": {
                "url": "https://jasonette.github.io/Jasonpedia/webcontainer/agent/ignore.json",
                "preload": {
                  "background": "#ffffff"
                }
              }
            },
            {
              "type": "vertical",
              "components": [
                {
                  "type": "label",
                  "text": "$default Link Click Handling",
                  "style": {
                    "font": "HelveticaNeue-Bold",
                    "size": "14"
                  }
                },
                {
                  "type": "label",
                  "text": "Setting type: $default as the action will let the web container behave like a regular browser",
                  "style": {
                    "font": "HelveticaNeue",
                    "size": "12"
                  }
                }
              ],
              "href": {
                "url": "https://jasonette.github.io/Jasonpedia/webcontainer/agent/default.json",
                "preload": {
                  "background": "#ffffff"
                }
              }
            },
            {
              "type": "vertical",
              "components": [
                {
                  "type": "label",
                  "text": "Selective Link Click Handling via native jasonette action",
                  "style": {
                    "font": "HelveticaNeue-Bold",
                    "size": "14"
                  }
                },
                {
                  "type": "label",
                  "text": "You can set an action attribute to handle link clicks",
                  "style": {
                    "font": "HelveticaNeue",
                    "size": "12"
                  }
                }
              ],
              "href": {
                "url": "https://jasonette.github.io/Jasonpedia/webcontainer/agent/hijack.json",
                "preload": {
                  "background": "#ffffff"
                }
              }
            },
            {
              "type": "vertical",
              "components": [
                {
                  "type": "label",
                  "text": "Jasonette => Web Container $agent function call",
                  "style": {
                    "font": "HelveticaNeue-Bold",
                    "size": "14"
                  }
                },
                {
                  "type": "label",
                  "text": "The $jason.body.background web container is implemented as an agent. This means it supports all $agent APIs between Jasonette core and the container",
                  "style": {
                    "font": "HelveticaNeue",
                    "size": "12"
                  }
                }
              ],
              "href": {
                "url": "https://jasonette.github.io/Jasonpedia/webcontainer/agent/fn/index.json",
                "preload": {
                  "background": "#ffffff"
                }
              }
            },
            {
              "type": "vertical",
              "components": [
                {
                  "type": "label",
                  "text": "Hybrid App",
                  "style": {
                    "font": "HelveticaNeue-Bold",
                    "size": "14"
                  }
                },
                {
                  "type": "label",
                  "text": "Blur the line between web and native by seamlessly crossing over between native JASON view and web containers. In this case we use jasonbase.com to demonstrate this",
                  "style": {
                    "font": "HelveticaNeue",
                    "size": "12"
                  }
                }
              ],
              "href": {
                "url": "https://jasonette.github.io/Jasonpedia/webcontainer/agent/hybrid.json",
                "preload": {
                  "background": "#ffffff"
                }
              }
            }
          ]
        }
      ]
    }
  }
}
