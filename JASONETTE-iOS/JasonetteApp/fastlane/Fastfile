default_platform(:ios)

BUNDLE_ID = "com.bande-a-bonnot.jasonette"
PROFILE_NAME = "com.bande-a-bonnot.jasonette"
TEAM_ID = "PKPPLFK854"

PROJECT_ROOT = File.expand_path("..", __dir__)
WORKSPACE = File.join(PROJECT_ROOT, "Jasonette.xcworkspace")
SCHEME = "Jasonette-iOS"
ARCHIVE_PATH = File.join(PROJECT_ROOT, "build", "Jasonette.xcarchive")
IPA_DIR = File.join(PROJECT_ROOT, "build")

# Write P12 certificate to a temporary file, yield the path, then clean up.
def with_p12_temp_path
  require "tempfile"
  require "base64"
  file = Tempfile.new(["dist_cert", ".p12"])
  begin
    file.binmode
    file.write(Base64.decode64(ENV.fetch("APPLE_DISTRIBUTION_CERTIFICATE_P12")))
    file.close
    yield file.path
  ensure
    file.unlink if file
  end
end

platform :ios do
  before_all do
    if ENV["CI"]
      setup_ci
      app_store_connect_api_key if ENV["APP_STORE_CONNECT_API_KEY_KEY_ID"]
    end
  end

  lane :fetch_signing do
    if ENV["CI"]
      with_p12_temp_path do |cert_path|
        import_certificate(
          certificate_path: cert_path,
          certificate_password: ENV["APPLE_DISTRIBUTION_CERTIFICATE_PASSWORD"],
          keychain_name: "fastlane_tmp_keychain",
        )
      end
    end

    get_provisioning_profile(
      app_identifier: BUNDLE_ID,
      provisioning_name: PROFILE_NAME,
      readonly: true,
    )
  end

  lane :build do |options|
    version = options[:version] || "0.1.0"
    build_number = options[:build_number] || ENV["GITHUB_RUN_NUMBER"] || "1"

    # Generate Xcode project from Tuist manifests
    sh("mise", "exec", "--", "tuist", "install")
    sh("mise", "exec", "--", "tuist", "generate", "--no-open")

    build_app(
      workspace: WORKSPACE,
      scheme: SCHEME,
      configuration: "Release",
      archive_path: ARCHIVE_PATH,
      output_directory: IPA_DIR,
      output_name: "Jasonette.ipa",
      include_symbols: true,
      export_method: "app-store",
      export_options: {
        teamID: TEAM_ID,
        provisioningProfiles: {
          BUNDLE_ID => PROFILE_NAME,
        },
      },
      xcargs: [
        "DEVELOPMENT_TEAM=#{TEAM_ID}",
        "MARKETING_VERSION=#{version}",
        "CURRENT_PROJECT_VERSION=#{build_number}",
      ].join(" "),
    )
  end

  lane :upload_testflight do
    ipa_path = File.join(IPA_DIR, "Jasonette.ipa")
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    upload_to_testflight(
      ipa: ipa_path,
      app_identifier: BUNDLE_ID,
      skip_waiting_for_build_processing: true,
    )
  end

  lane :upload_appstore do
    ipa_path = File.join(IPA_DIR, "Jasonette.ipa")
    UI.user_error!("IPA not found at #{ipa_path}") unless File.exist?(ipa_path)

    deliver(
      ipa: ipa_path,
      app_identifier: BUNDLE_ID,
      submit_for_review: true,
      automatic_release: true,
      phased_release: true,
      reject_if_possible: true,
      force: true,
      skip_metadata: true,
      skip_screenshots: true,
    )
  end
end
