{
  "config": {
    // Disable line length rule — many spec sections have long lines
    "MD013": false,
    // Allow inline HTML
    "MD033": false,
    // Allow sibling duplicate headings (different sections can reuse heading names)
    "MD024": { "siblings_only": true },
    // Allow trailing punctuation in headings (e.g., "What is $jason?")
    "MD026": { "punctuation": ".,;:!" }
  },
  "ignores": [
    "node_modules/**",
    "JASONETTE-iOS/**",
    "JASONETTE-Android/**",
    "Jasonette-Blog/**",
    "Jasonette-documentation/**",
    "Jasonpedia/**"
  ]
}
